# Check environment for the Conductor (compose service dev): Go, golangci-lint,
# Node.js, kustomize and hadolint, all pinned. No Docker inside.
FROM node:24.22.1-bookworm-slim AS node

FROM golang:1.26.10-bookworm

ARG GOLANGCI_LINT_VERSION=2.15.0
ARG KUSTOMIZE_VERSION=5.8.3
ARG HADOLINT_VERSION=2.15.1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
# go/gofmt links: a login shell (sh -l) resets PATH and drops /usr/local/go/bin.
RUN ln -s /usr/local/go/bin/go /usr/local/bin/go \
    && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node --version && npm --version

RUN arch="$(dpkg --print-architecture)" \
    && case "${arch}" in \
         amd64) hadolint_arch=x86_64 ;; \
         arm64) hadolint_arch=arm64 ;; \
         *) echo "unsupported architecture ${arch}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-${arch}.tar.gz" \
       | tar -xz -C /usr/local/bin --strip-components=1 "golangci-lint-${GOLANGCI_LINT_VERSION}-linux-${arch}/golangci-lint" \
    && curl -fsSL "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv${KUSTOMIZE_VERSION}/kustomize_v${KUSTOMIZE_VERSION}_linux_${arch}.tar.gz" \
       | tar -xz -C /usr/local/bin kustomize \
    && curl -fsSL -o /usr/local/bin/hadolint "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-linux-${hadolint_arch}" \
    && chmod 0755 /usr/local/bin/hadolint \
    && golangci-lint --version && kustomize version && hadolint --version

ENV GOFLAGS=-buildvcs=false \
    CGO_ENABLED=1

WORKDIR /workspace
CMD ["sleep", "infinity"]
